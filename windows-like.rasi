/* ~/.config/rofi/windows-like.rasi */

* {
    /* Paleta de colores: Gris oscuro y blanco no puro */
    bg-dark: #1E1E1E;
    bg-light: #2D2D2D;
    bg-selected: #3A3A3A;
    fg-soft: #E0E0E0;
    fg-dim: #A0A0A0;

    /* Tipografía y espaciado */
    font: "Sans 10";
    margin: 0;
    padding: 0;
    spacing: 0;
    border-radius: 0;
}

window {
    background-color: @bg-dark;
    border: 2px solid #333333;
    /* --- POSICIONAMIENTO Y TAMAÑO --- */
    location: south west;      /* Ancla la ventana en la esquina inferior izquierda del monitor */
    anchor: south west;        /* Hace que el punto de anclaje de la ventana sea su esquina inferior izquierda */
    width: 400px;              /* Ancho fijo para mantener la forma cuadrada */
    height: 400px;             /* Alto igual al ancho para que sea un cuadrado */
    margin: 0 0 35px 0;        /* Margen: top right bottom left. Aplica 35px en la parte inferior */
    padding: 15px;
}

/* Barra de entrada de texto (opcional, pero útil) */
inputbar {
    background-color: @bg-dark;
    text-color: @fg-soft;
    padding: 8px;
    margin: 0 0 10px 0;
    /* Corrección: se añade el estilo 'solid' y el color al borde */
    border: 0px 0px 1px 0px solid #444444;
}

/* Contenedor principal de la lista de aplicaciones */
listview {
    background-color: transparent;
    columns: 2;          /* Fuerza 2 aplicaciones por fila */
    lines: 4;            /* Muestra 4 filas (8 apps visibles) */
    spacing: 12px;       /* Espacio entre celdas de la cuadrícula */
    scrollbar: false;
}

/* Estilo de cada celda (elemento) de la cuadrícula */
element {
    background-color: transparent;
    padding: 10px;
    border-radius: 0;
}

/* Estilo de la celda al pasar el ratón por encima */
element selected {
    background-color: @bg-selected;
    text-color: @fg-soft;
}

/* Estructura interna de cada elemento: Icono arriba, Texto abajo */
element-icon {
    size: 48px;          /* Tamaño del icono */
    horizontal-align: 0.5; /* Centra el icono horizontalmente */
    vertical-align: 0.5;
    margin: 0 0 5px 0;   /* Espacio entre icono y texto */
}

/* Estilo unificado para el texto de cada elemento */
element-text {
    horizontal-align: 0.5; /* Centra el texto horizontalmente */
    vertical-align: 0.5;
    text-color: @fg-soft;
    font: "Sans 9";      /* Fuente un poco más pequeña para el nombre */
    ellipsize: middle;   /* Evita que el texto se corte si es muy largo */
}