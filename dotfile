#!/usr/bin/env bash
# instalar-jwm-ligero.sh
# Instala JWM + dependencias mínimas y coloca un .jwmrc ligero en antiX/Debian.
# Uso: bash instalar-jwm-ligero.sh

set -euo pipefail

# ---------- Colores para los mensajes ----------
VERDE='\033[0;32m'
AMARILLO='\033[1;33m'
ROJO='\033[0;31m'
NC='\033[0m'

info()  { echo -e "${VERDE}[INFO]${NC} $*"; }
aviso() { echo -e "${AMARILLO}[AVISO]${NC} $*"; }
error() { echo -e "${ROJO}[ERROR]${NC} $*" >&2; }

# ---------- Comprobar que no somos root ----------
if [[ $EUID -eq 0 ]]; then
  error "No ejecutes este script como root. Usa tu usuario normal; se pedirá sudo cuando haga falta."
  exit 1
fi

# ---------- 1. Instalar paquetes ----------
info "Instalando JWM, configuración por defecto de antiX y dependencias mínimas..."
PAQUETES=(jwm feh x11-xserver-utils xinit rofi conman-gtk pcmanfm leafpad ) 
if apt-cache show desktop-defaults-jwm-antix >/dev/null 2>&1; then
  PAQUETES+=(desktop-defaults-jwm-antix)
else
  aviso "desktop-defaults-jwm-antix no está disponible; se omite (no es imprescindible)."
fi

sudo apt install -y "${PAQUETES[@]}"

# ---------- 2. Copia de seguridad del .jwmrc existente ----------
if [[ -f "$HOME/.jwmrc" ]]; then
  RESPALDO="$HOME/.jwmrc.bak.$(date +%Y%m%d-%H%M%S)"
  info "Guardando copia de seguridad en $RESPALDO"
  cp -a "$HOME/.jwmrc" "$RESPALDO"
else
  info "No había ~/.jwmrc previo; no hay nada que respaldar."
fi

# ---------- 3. Escribir el nuevo .jwmrc ----------
info "Escribiendo el nuevo ~/.jwmrc ..."
cat > "$HOME/.jwmrc" <<'EOF'
<?xml version="1.0"?>
<JWM>

  <!-- ================= MENÚ PRINCIPAL ================= -->
  <RootMenu height="18" onroot="123">
    <Include>$HOME/.jwm/menu</Include>

    <Separator/>
    <Program label="Gestor de archivos" icon="/usr/share/icons/papirus-antix/48x48/apps/system-file-manager.png">pcmanfm</Program>
    <Program label="Navegador" icon="/usr/share/icons/papirus-antix/48x48/apps/web-browser.png">falkon</Program>
    <Program label="Editor de texto" icon="/usr/share/icons/papirus-antix/48x48/apps/accessories-text-editor.png">leafpad</Program>
    <Separator/>
    <Program label="Bloquear pantalla" icon="/usr/share/icons/papirus-antix/48x48/apps/system-lock-screen.png">xlock -mode blank</Program>
    <Restart label="Reiniciar JWM" icon="/usr/share/icons/papirus-antix/48x48/actions/view-refresh.png"/>
    <Exit label="Salir" confirm="true" icon="/usr/share/icons/papirus-antix/48x48/actions/system-log-out.png"/>
    <Program label="Apagar" icon="/usr/share/icons/papirus-antix/48x48/actions/system-shutdown.png">sudo poweroff</Program>
  </RootMenu>

  <!-- ================= BARRA DE TAREAS ================= -->
  <Tray x="0" y="-1" height="30" autohide="false">
  <TrayButton popup="Conexión WiFi" icon="/usr/share/icons/papirus-antix/48x48/apps/network-wireless.png">exec:conman-gtk</TrayButton>

    <TrayButton icon="/usr/share/icons/papirus-antix/48x48/places/start-here.png">root:1</TrayButton>
    <Spacer width="4"/>
    <TrayButton popup="Rofi" icon="/usr/share/icons/papirus-antix/48x48/apps/system-search.png">exec:rofi -show drun</TrayButton>
    <TrayButton popup="Archivos" icon="/usr/share/icons/papirus-antix/48x48/apps/system-file-manager.png">exec:pcmanfm</TrayButton>
    <TrayButton popup="Navegador" icon="/usr/share/icons/papirus-antix/48x48/apps/web-browser.png">exec:falkon</TrayButton>
    <TrayButton popup="Mostrar escritorio" icon="/usr/share/icons/papirus-antix/48x48/places/user-desktop.png">showdesktop</TrayButton>
    <Spacer width="8"/>
    <TaskList maxwidth="300"/>
    <Dock/>
    <Clock format="%H:%M">exec:xclock</Clock>
  </Tray>

  <!-- ================= ESTILOS VISUALES ================= -->
  <WindowStyle>
    <Font>Sans-9:bold</Font>
    <Width>3</Width>
    <Height>22</Height>
    <Active>
      <Text>#EDEDED</Text>
      <Title>#000000:#505050</Title>
      <Background>#272727</Background>
      <Outline>#000000</Outline>
    </Active>
    <Inactive>
      <Text>#A9A9A9</Text>
      <Title>#505050:#000000</Title>
      <Background>#272727</Background>
      <Outline>#000000</Outline>
    </Inactive>
  </WindowStyle>

  <TaskListStyle>
    <Font>Sans-9:bold</Font>
    <ActiveForeground>#EDEDED</ActiveForeground>
    <ActiveBackground>#109567:#202020</ActiveBackground>
    <Background>#202020:#202020</Background>
  </TaskListStyle>

  <TrayStyle>
    <Font>Sans-9:bold</Font>
    <Foreground>#EDEDED</Foreground>
    <Background>#202020</Background>
  </TrayStyle>

  <MenuStyle>
    <Font>Sans-9:bold</Font>
    <Foreground>#EDEDED</Foreground>
    <Background>#202020</Background>
    <Active>
      <Foreground>#EDEDED</Foreground>
      <Background>#109567</Background>
    </Active>
  </MenuStyle>

  <PopupStyle>
    <Font>Sans-9</Font>
    <Outline>#808080</Outline>
    <Foreground>#EDEDED</Foreground>
    <Background>#272727</Background>
  </PopupStyle>

  <!-- ================= ICONOS ================= -->
  <IconPath>
    /usr/share/icons/papirus-antix
    /usr/share/icons/hicolor
    /usr/share/pixmaps
  </IconPath>

  <!-- ================= ESCRITORIO ================= -->
  <Desktops width="2" height="2">
    <Background type="command">feh --bg-scale /usr/share/antiX/wallpaper/antiX-wallpaper.png</Background>
  </Desktops>

  <!-- ================= COMPORTAMIENTO ================= -->
  <DoubleClickSpeed>400</DoubleClickSpeed>
  <DoubleClickDelta>2</DoubleClickDelta>
  <FocusModel>sloppy</FocusModel>
  <SnapMode distance="10">border</SnapMode>
  <MoveMode>opaque</MoveMode>
  <ResizeMode>opaque</ResizeMode>

  <!-- ================= ATAJOS DE TECLADO ================= -->
  <Key key="Up">up</Key>
  <Key key="Down">down</Key>
  <Key key="Right">right</Key>
  <Key key="Left">left</Key>
  <Key key="Return">select</Key>
  <Key key="Escape">escape</Key>

  <Key mask="A" key="Tab">next</Key>
  <Key mask="A" key="F4">close</Key>
  <Key mask="A" key="#">desktop#</Key>
  <Key mask="A" key="F1">root:1</Key>
  <Key mask="A" key="F2">window</Key>
  <Key mask="A" key="F10">maximize</Key>
  <Key mask="A" key="Right">rdesktop</Key>
  <Key mask="A" key="Left">ldesktop</Key>
  <Key mask="A" key="Up">udesktop</Key>
  <Key mask="A" key="Down">ddesktop</Key>
</JWM>


info "~/.jwmrc escrito correctamente."

# ---------- 4. Ajustar fondo de pantalla si la ruta no existe ----------
WALLPAPER="/usr/share/antiX/wallpaper/antiX-wallpaper.png"
if [[ ! -f "$WALLPAPER" ]]; then
  aviso "No se encontró $WALLPAPER. Cambiando el fondo por un color sólido con xsetroot."
  sed -i 's|feh --bg-scale /usr/share/antiX/wallpaper/antiX-wallpaper.png|xsetroot -solid "#202020"|' "$HOME/.jwmrc"
fi

# ---------- 5. Comprobar que .jwm/menu existe (para el Include) ----------
if [[ ! -f "$HOME/.jwm/menu" ]]; then
  aviso "No existe ~/.jwm/menu. El menú solo mostrará las entradas manuales."
  aviso "Si instalaste desktop-defaults-jwm-antix, copia la plantilla con:"
  aviso "  cp -r /etc/skel/.jwm ~/ 2>/dev/null || true"
fi

# ---------- 6. Validar la configuración ----------
if command -v jwm >/dev/null 2>&1; then
  info "Comprobando sintaxis de la configuración con 'jwm -c'..."
  if jwm -c "$HOME/.jwmrc" 2>/tmp/jwm-check.err; then
    info "La configuración de JWM es válida."
  else
    aviso "JWM reportó posibles problemas (no siempre son fatales):"
    cat /tmp/jwm-check.err
  fi
fi

# ---------- 7. Crear estilo minimalista para Rofi ----------
info "Creando estilo minimalista para Rofi..."
mkdir -p "$HOME/.config/rofi"
cat > "$HOME/.config/rofi/config.rasi" <<'EOF'
configuration {
    modi: "drun";
    font: "Sans 9";
    show-icons: true;
    color-enabled: true;
    color-window: "#202020, #202020, #000000";
    color-normal: "#202020, #EDEDED, #202020, #109567, #EDEDED";
    color-active: "#202020, #109567, #202020, #109567, #EDEDED";
    color-urgent: "#202020, #EDEDED, #202020, #FF0000, #EDEDED";
}


info "Estilo minimalista para Rofi creado en ~/.config/rofi/config.rasi."

# ---------- 8. Instrucciones finales ----------
echo
info "Instalación completada."
echo "Para probar JWM sin cerrar tu sesión actual:"
echo "  jwm -c ~/.jwmrc &"
echo
echo "Para arrancarlo desde la terminal con startx, asegúrate de que ~/.xinitrc termine en:"
echo "  exec jwm"
echo
echo "Si algo no te gusta, tu configuración anterior está en:"
echo "  $HOME/.jwmrc.bak.*"
EOF